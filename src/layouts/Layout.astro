---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/jetbrains-mono/400.css';
import globalStyles from '../styles/global.css?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Portfolio of [YOUR NAME], network and cybersecurity engineer.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // '/portfolio' or ''
const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <link rel="stylesheet" href={globalStyles} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" href={`${base}/favicon.ico`} />

    <title>{title}</title>

    <!-- FOUC guard: sets .dark class and background before first paint -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          var isDark = !(stored === 'light' || (stored === null && prefersLight));
          if (isDark) {
            document.documentElement.classList.add('dark');
            document.documentElement.style.backgroundColor = '#0f0f0f';
          } else {
            document.documentElement.style.backgroundColor = '#f5f3f0';
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="font-sans antialiased flex flex-col min-h-screen">
    <Header />
    <slot />
    <Footer />
  </body>
</html>
