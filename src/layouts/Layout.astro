---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Portfolio of [YOUR NAME], network and cybersecurity engineer.',
} = Astro.props;

const siteUrl = '[YOUR SITE URL]'; // e.g. https://username.github.io/portfolio — replace before deploying
const canonicalURL = siteUrl.startsWith('http')
  ? new URL(Astro.url.pathname, siteUrl).href
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Canonical — omitted until [YOUR SITE URL] is set -->
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <title>{title}</title>

    <!--
      FOUC guard: applies .dark before first paint.
      Default is dark unless localStorage says 'light' or
      the system explicitly prefers light with no stored preference.
    -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          if (stored === 'light' || (stored === null && prefersLight)) {
            // stay light
          } else {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Prevents white flash before CSS bundle loads -->
    <style>
      html { background-color: #0f0f0f; }
      html:not(.dark) { background-color: #f5f3f0; }
    </style>
  </head>
  <body class="font-sans antialiased flex flex-col min-h-screen">
    <Header />
    <slot />
    <Footer />
  </body>
</html>
