---
import Layout from '../layouts/Layout.astro';

const skills: { category: string; items: string[] }[] = [
  {
    category: 'Networking',
    items: [
      'Computer Networking',
      'Cisco Routing & Switching',
      'Network Architecture & Design',
      'Network Device Configuration',
      'Equipment Swap & Deployment',
      'TCP/UDP · SSH · DNS · DHCP · MFA',
    ],
  },
  {
    category: 'Security & Compliance',
    items: [
      'Palo Alto Firewall',
      'Security Policy Design',
      'NERC-CIP Compliance (CIP-002, CIP-007, CIP-010)',
    ],
  },
  {
    category: 'Industrial / OT',
    items: ['IT/OT Network Segmentation', 'SCADA Network Communication'],
  },
  {
    category: 'Tools & Programming',
    items: ['Microsoft Office 365', 'Python'],
  },
];
---

<Layout
  title="About — Jason Pitt"
  description="Jason Pitt is a network cybersecurity analyst working remotely across the US. Learn more about his background and skills."
>
  <main class="mx-auto max-w-3xl px-6 py-14">

    <!-- Bio -->
    <section aria-label="Introduction">
      <p class="font-mono text-sm mb-6">
        <span class="text-accent" aria-hidden="true">{'>'}</span>
        <span class="ml-2 text-muted">about</span>
      </p>

      <h1 class="text-3xl font-semibold tracking-tight">Jason Pitt</h1>
      <p class="mt-1 text-lg text-secondary">Network Cybersecurity Analyst &mdash; Remote, US</p>

      <div class="mt-8 space-y-4 max-w-prose">
        <p class="text-secondary leading-relaxed">
          I work on IT networking &amp; security &mdash; switching, routing, firewall analytics,
          baseload monitoring, and network build-out are my day-to-day work.
        </p>
        <p class="text-secondary leading-relaxed">
          What I care about most is a clean and efficient environment that helps everyone
          communicate safely and reliably.
        </p>
      </div>
    </section>

    <!-- Skills -->
    <section aria-label="Skills" class="mt-20">
      <p class="font-mono text-sm mb-8">
        <span class="text-accent" aria-hidden="true">{'>'}</span>
        <span class="ml-2 text-muted">skills</span>
      </p>

      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-10">
        {skills.map(({ category, items }) => (
          <div>
            <dt class="font-mono text-xs text-muted uppercase tracking-widest mb-4">{category}</dt>
            <dd>
              <ul class="space-y-2">
                {items.map(item => (
                  <li class="text-sm text-secondary">{item}</li>
                ))}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </section>

  </main>
</Layout>
