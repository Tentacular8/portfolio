---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getPublishedProjects } from '../../utils/projects';

export const getStaticPaths: GetStaticPaths = async () => {
  const projects = await getPublishedProjects();
  return projects.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
};

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const dateStr = entry.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
});
---

<Layout title={`${entry.data.title} — Jason Pitt`} description={entry.data.summary}>
  <main class="mx-auto max-w-3xl flex-1 px-6 py-14">

    <a
      href={`${base}/projects`}
      class="inline-flex items-center gap-1.5 font-mono text-xs text-muted hover:text-accent focus-ring rounded mb-12"
    >
      <span aria-hidden="true">←</span> all projects
    </a>

    <article>

      <!-- Title + summary -->
      <header class="mb-10 pb-10 border-b border-subtle">
        <h1 class="text-3xl font-semibold tracking-tight">{entry.data.title}</h1>
        <p class="mt-3 text-lg text-secondary leading-relaxed">{entry.data.summary}</p>

        <!-- Role + date -->
        <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-xs text-muted">
          {entry.data.role && <span>{entry.data.role}</span>}
          <span>{dateStr}</span>
        </div>

        <!-- Tech tags -->
        <ul class="mt-4 flex flex-wrap gap-2" role="list">
          {entry.data.techStack.map((t) => (
            <li>
              <span class="font-mono text-xs text-secondary border border-subtle rounded px-2 py-0.5">
                {t}
              </span>
            </li>
          ))}
        </ul>

        <!-- Links -->
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={entry.data.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-md border border-subtle px-4 py-2 text-sm font-medium text-secondary hover:border-accent hover:text-accent focus-ring"
          >
            GitHub <span aria-hidden="true">↗</span>
          </a>
          {entry.data.demoUrl && (
            <a
              href={entry.data.demoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-md border border-accent px-4 py-2 text-sm font-medium text-accent hover:bg-surface focus-ring"
            >
              Live demo <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </header>

      <!-- Hero image -->
      {entry.data.heroImage && (
        <div class="mb-10 overflow-hidden rounded-md border border-subtle bg-surface">
          <img
            src={entry.data.heroImage?.startsWith('/') ? `${base}${entry.data.heroImage}` : entry.data.heroImage}
            alt={`${entry.data.title} — hero image`}
            class="w-full object-cover"
            loading="eager"
          />
        </div>
      )}

      <!-- Case study prose (markdown body) -->
      <div class="prose">
        <Content />
      </div>

    </article>
  </main>
</Layout>
