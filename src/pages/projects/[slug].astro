---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';
import type { Project } from '../../data/projects';

export const getStaticPaths: GetStaticPaths = () => {
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
};

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<Layout title={`${project.title} — [YOUR NAME]`} description={project.summary}>
  <main class="mx-auto max-w-3xl flex-1 px-6 py-14">

    <!-- Back link -->
    <a
      href="/projects"
      class="inline-flex items-center gap-1.5 font-mono text-xs text-muted hover:text-accent focus-ring rounded mb-12"
    >
      <span aria-hidden="true">←</span> all projects
    </a>

    <article>
      <!-- Title + summary -->
      <header class="mb-12">
        <h1 class="text-3xl font-semibold tracking-tight">{project.title}</h1>
        <p class="mt-3 text-lg text-secondary leading-relaxed">{project.summary}</p>
      </header>

      <!-- Hero image -->
      {project.heroImage && (
        <div class="mb-12 overflow-hidden rounded-md border border-subtle bg-surface">
          <img
            src={project.heroImage}
            alt={`${project.title} — hero image`}
            class="w-full object-cover"
            loading="eager"
          />
        </div>
      )}

      <!-- Problem -->
      <section class="mb-10" aria-labelledby="section-problem">
        <h2
          id="section-problem"
          class="font-mono text-xs text-muted uppercase tracking-widest mb-4"
        >Problem</h2>
        <p class="text-secondary leading-relaxed">{project.problem}</p>
      </section>

      <!-- Approach -->
      <section class="mb-10" aria-labelledby="section-approach">
        <h2
          id="section-approach"
          class="font-mono text-xs text-muted uppercase tracking-widest mb-4"
        >Approach</h2>
        <p class="text-secondary leading-relaxed">{project.approach}</p>
      </section>

      <!-- Tech stack -->
      <section class="mb-10" aria-labelledby="section-tech">
        <h2
          id="section-tech"
          class="font-mono text-xs text-muted uppercase tracking-widest mb-4"
        >Tech stack</h2>
        <ul class="flex flex-wrap gap-2" role="list">
          {project.techStack.map((t) => (
            <li>
              <span class="font-mono text-xs text-secondary border border-subtle rounded px-2 py-1">
                {t}
              </span>
            </li>
          ))}
        </ul>
      </section>

      <!-- Screenshots -->
      {project.screenshots && project.screenshots.length > 0 && (
        <section class="mb-10" aria-labelledby="section-screenshots">
          <h2
            id="section-screenshots"
            class="font-mono text-xs text-muted uppercase tracking-widest mb-4"
          >Screenshots</h2>
          <div class="space-y-4">
            {project.screenshots.map((src, i) => (
              <div class="overflow-hidden rounded-md border border-subtle bg-surface">
                <img
                  src={src}
                  alt={`${project.title} — screenshot ${i + 1}`}
                  class="w-full"
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- What I learned -->
      <section class="mb-12" aria-labelledby="section-learned">
        <h2
          id="section-learned"
          class="font-mono text-xs text-muted uppercase tracking-widest mb-4"
        >What I learned</h2>
        <p class="text-secondary leading-relaxed">{project.whatILearned}</p>
      </section>

      <!-- Links -->
      {(project.demoUrl || project.repoUrl) && (
        <footer class="flex flex-wrap gap-4 border-t border-subtle pt-8">
          {project.demoUrl && (
            <a
              href={project.demoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-md border border-accent px-4 py-2 text-sm font-medium text-accent hover:bg-surface focus-ring"
            >
              Live demo <span aria-hidden="true">↗</span>
            </a>
          )}
          {project.repoUrl && (
            <a
              href={project.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-md border border-subtle px-4 py-2 text-sm font-medium text-secondary hover:border-accent hover:text-accent focus-ring"
            >
              GitHub repo <span aria-hidden="true">↗</span>
            </a>
          )}
        </footer>
      )}
    </article>

  </main>
</Layout>
