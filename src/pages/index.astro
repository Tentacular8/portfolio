---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Portfolio">
  <Header />

  <main class="mx-auto max-w-3xl px-6 py-20">
    <!-- Hero -->
    <section aria-label="Introduction">
      <h1 class="text-4xl font-semibold tracking-tight">Your Name</h1>
      <p class="mt-4 max-w-xl text-lg leading-relaxed text-muted">
        Cybersecurity engineer. I build secure systems and break insecure ones.
      </p>
    </section>

    <!-- Projects -->
    <section aria-label="Projects" class="mt-24">
      <p class="mb-8 font-mono text-sm">
        <span class="text-accent" aria-hidden="true">{'>'}</span>
        <span class="ml-2 text-muted">projects</span>
      </p>
      <div class="rounded-md border border-subtle bg-surface p-6">
        <p class="font-mono text-sm text-muted">// content coming soon</p>
      </div>
    </section>
  </main>

  <footer class="mt-24 border-t border-subtle">
    <div class="mx-auto max-w-3xl px-6 py-6">
      <p class="font-mono text-xs text-muted">
        built · {new Date().toISOString().split('T')[0]}
      </p>
    </div>
  </footer>
</Layout>
