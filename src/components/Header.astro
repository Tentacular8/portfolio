---
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // '/portfolio' or ''
const { pathname } = Astro.url;

function isActive(path: string): boolean {
  if (path === '/') return pathname === `${base}/` || pathname === base;
  return pathname.startsWith(`${base}${path}`);
}
---

<header class="sticky top-0 z-50 border-b border-subtle bg-base">
  <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">

    <!-- Logo -->
    <a href={`${base}/`} class="font-mono text-sm font-medium text-accent focus-ring rounded" aria-label="Home">
      ~/portfolio
    </a>

    <!-- Desktop nav -->
    <nav aria-label="Site navigation" class="hidden md:flex items-center gap-6">
      <a
        href={`${base}/`}
        class:list={['text-sm focus-ring rounded', isActive('/') ? 'text-accent font-medium' : 'text-secondary hover:text-accent']}
      >home</a>
      <a
        href={`${base}/projects`}
        class:list={['text-sm focus-ring rounded', isActive('/projects') ? 'text-accent font-medium' : 'text-secondary hover:text-accent']}
      >projects</a>
      <a
        href={`${base}/about`}
        class:list={['text-sm focus-ring rounded', isActive('/about') ? 'text-accent font-medium' : 'text-secondary hover:text-accent']}
      >about</a>
      <a
        href={`${base}/contact`}
        class:list={['text-sm focus-ring rounded', isActive('/contact') ? 'text-accent font-medium' : 'text-secondary hover:text-accent']}
      >contact</a>
      <ThemeToggle />
    </nav>

    <!-- Mobile controls -->
    <div class="flex items-center gap-1 md:hidden">
      <ThemeToggle />
      <button
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open navigation menu"
        class="rounded-md p-2 text-secondary hover:text-accent focus-ring"
      >
        <svg id="icon-open" class="h-5 w-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <svg id="icon-close" class="hidden h-5 w-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <nav
    id="mobile-menu"
    aria-label="Mobile navigation"
    class="hidden border-t border-subtle md:hidden"
  >
    <div class="mx-auto flex max-w-3xl flex-col gap-1 px-6 py-4">
      <a href={`${base}/`} class:list={['rounded px-2 py-2 text-sm focus-ring', isActive('/') ? 'text-accent font-medium' : 'text-secondary']}>home</a>
      <a href={`${base}/projects`} class:list={['rounded px-2 py-2 text-sm focus-ring', isActive('/projects') ? 'text-accent font-medium' : 'text-secondary']}>projects</a>
      <a href={`${base}/about`} class:list={['rounded px-2 py-2 text-sm focus-ring', isActive('/about') ? 'text-accent font-medium' : 'text-secondary']}>about</a>
      <a href={`${base}/contact`} class:list={['rounded px-2 py-2 text-sm focus-ring', isActive('/contact') ? 'text-accent font-medium' : 'text-secondary']}>contact</a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isNowHidden = menu?.classList.toggle('hidden');
    const expanded = !isNowHidden;

    toggle.setAttribute('aria-expanded', String(expanded));
    toggle.setAttribute('aria-label', expanded ? 'Close navigation menu' : 'Open navigation menu');
    iconOpen?.classList.toggle('hidden', expanded);
    iconClose?.classList.toggle('hidden', !expanded);
  });
</script>
